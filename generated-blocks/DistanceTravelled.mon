package apamax.analyticsbuilder.custom;

using apama.analyticsbuilder.BlockBase;
using apama.analyticsbuilder.Activation;
using apama.analyticsbuilder.L10N;
using apama.analyticsbuilder.Value;
using com.apama.util.AnyExtractor;

/**
 * State of the DistanceTravelled block — persisted across activations.
 */
event DistanceTravelled_$State {
	optional<float> previousLat;
	optional<float> previousLng;
}

/**
 * DistanceTravelled
 *
 * Calculates the distance travelled between successive GPS positions using the haversine great circle distance formula.
 *
 * The block receives a stream of c8y_Position events (as Value objects) and calculates the distance in meters
 * between the previous and current position. On the first position, no output is produced; subsequent positions
 * trigger an output of the distance travelled. Altitude is ignored; only latitude and longitude are used to 
 * calculate the great circle distance on Earth's surface (assuming a sphere of radius 6,371,000 meters).
 * 
 * If a position is missing latitude or longitude, no output is produced and the position is not stored as the
 * previous position.
 *
 * @$blockCategory Calculations
 */
event DistanceTravelled {

	BlockBase $base;

	/**
	 * @param $activation The current activation.
	 * @param $input_position Input position as a Value containing lat/lng in properties.
	 * @param $blockState The current persisted state of the block.
	 *
	 * @$inputName position Position
	 */
	action $process(Activation $activation, Value $input_position, DistanceTravelled_$State $blockState) {
		// If either lat or lng is not present (would be 0.0), skip
		if not $input_position.properties.hasKey("lat") or 
		   not $input_position.properties.hasKey("lng") {
			return;
		}

		// Extract lat and lng from the Value's properties dictionary
		// AnyExtractor.getFloatOr handles int-to-float conversion and missing keys
		float currentLat := AnyExtractor($input_position.properties).getFloatOr("lat", 0.0);
		float currentLng := AnyExtractor($input_position.properties).getFloatOr("lng", 0.0);
				
		// If this is the first position, just store it and produce no output
		ifpresent $blockState.previousLat as prevLat {
			ifpresent $blockState.previousLng as prevLng {
				// Calculate haversine distance
				float distance := calculateHaversine(prevLat, prevLng, currentLat, currentLng);
				$setOutput_distance($activation, distance);
			}
		}
		
		// Store current position for next activation
		$blockState.previousLat := currentLat;
		$blockState.previousLng := currentLng;
	}

	/**
	 * Calculate great circle distance using haversine formula.
	 * 
	 * @param lat1 Latitude of first point in degrees
	 * @param lng1 Longitude of first point in degrees
	 * @param lat2 Latitude of second point in degrees
	 * @param lng2 Longitude of second point in degrees
	 * @return Distance in meters
	 */
	action calculateHaversine(float lat1, float lng1, float lat2, float lng2) returns float {
		// Earth's radius in meters
		float R := 6371000.0;
		
		// Convert degrees to radians
		float lat1_rad := lat1 * float.PI / 180.0;
		float lat2_rad := lat2 * float.PI / 180.0;
		float dLat_rad := (lat2 - lat1) * float.PI / 180.0;
		float dLng_rad := (lng2 - lng1) * float.PI / 180.0;
		
		// Haversine formula
		// a = sin²(Δlat/2) + cos(lat1) × cos(lat2) × sin²(Δlng/2)
		float sin_dLat_2 := (dLat_rad / 2.0).sin();
		float sin_dLng_2 := (dLng_rad / 2.0).sin();
		
		float a := sin_dLat_2 * sin_dLat_2 + 
		           lat1_rad.cos() * lat2_rad.cos() * sin_dLng_2 * sin_dLng_2;
		
		// c = 2 × atan2(√a, √(1−a))
		float c := 2.0 * (a.sqrt() / (1.0 - a).sqrt()).atan();
		
		// d = R × c
		float distance := ((R * c) * 100.0).round().toFloat() / 100.0; // Round to 2 decimal places
		
		return distance;
	}

	/**
	 * Distance travelled in meters.
	 *
	 * The haversine great circle distance between the previous and current position.
	 * Altitude is ignored; only latitude and longitude are used.
	 */
	action<Activation,float> $setOutput_distance;
}
