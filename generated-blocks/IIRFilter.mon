package apamax.analyticsbuilder.custom;

using apama.analyticsbuilder.BlockBase;
using apama.analyticsbuilder.Activation;
using apama.analyticsbuilder.L10N;

/**
 * Parameters for IIRFilter.
 */
event IIRFilter_$Parameters {

	/**
	 * Smoothing factor.
	 *
	 * Controls the weight given to the current input value in the exponential moving average.
	 * Valid range: 0.0 to 1.0.
	 * - α ≈ 0.1: Slow, heavy smoothing. The series will lag behind raw changes but will be very smooth.
	 * - α ≈ 0.5: Moderate smoothing. Catches rapid changes while cutting out high-frequency noise.
	 * - α ≈ 0.9: Fast tracking. Follows the raw data closely with minimal smoothing.
	 */
	float alpha;

	action $validate() {
		if (not alpha.isFinite() or alpha < 0.0 or alpha > 1.0) {
			throw L10N.getLocalizedException("fwk_param_valid_range",
				[BlockBase.getL10N_param("alpha", self), "0.0", "1.0", alpha]);
		}
	}
}

/**
 * State of the IIRFilter block — persisted across activations.
 */
event IIRFilter_$State {
	optional<float> previousSmoothed;
}

/**
 * IIRFilter
 *
 * Smooths a time series using a first-order infinite impulse response (IIR) filter,
 * also known as an exponential moving average.
 *
 * The filter applies the formula: y[n] = α·x[n] + (1-α)·y[n-1]
 * - y[n]: Current smoothed output value
 * - x[n]: Current raw input value
 * - y[n-1]: Previous smoothed output value
 * - α: Smoothing factor (0 to 1)
 *
 * On the first activation, the smoothed output is initialized to the raw input value.
 * Subsequent activations blend the new input with the previous smoothed value according to α.
 *
 * The smoothing factor α controls the responsiveness: higher values (close to 1) follow
 * raw changes quickly with less smoothing; lower values (close to 0) heavily smooth the series
 * but lag behind rapid changes.
 *
 * @$blockCategory Calculations
 * @$derivedName IIR Filter α=$alpha
 */
event IIRFilter {

	BlockBase $base;
	IIRFilter_$Parameters $parameters;

	/**
	 * @param $activation The current activation.
	 * @param $input_value Raw data point to be smoothed.
	 * @param $blockState The current persisted state of the block.
	 *
	 * @$inputName value Value
	 */
	action $process(Activation $activation, float $input_value, IIRFilter_$State $blockState) {
		float smoothedValue;
		
		// Check if this is the first activation
		ifpresent $blockState.previousSmoothed as prevSmoothed {
			// Apply IIR formula: y[n] = α·x[n] + (1-α)·y[n-1]
			smoothedValue := ($parameters.alpha * $input_value) + ((1.0 - $parameters.alpha) * prevSmoothed);
		} else {
			// First activation: initialize to the raw input value
			smoothedValue := $input_value;
		}
		
		// Store the smoothed value for the next activation
		$blockState.previousSmoothed := smoothedValue;
		
		// Output the smoothed value
		$setOutput_smoothed($activation, smoothedValue);
	}

	/**
	 * Smoothed output value.
	 *
	 * The result of applying the IIR filter to the input stream using the configured α factor.
	 */
	action<Activation,float> $setOutput_smoothed;
}
